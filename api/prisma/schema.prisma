generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id         String             @id @default(uuid())
  fullName   String
  email      String             @unique
  department String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  records    ComplianceRecord[]
}

model ComplianceRecord {
  id                   String    @id @default(uuid())
  employeeId           String
  employee             Employee  @relation(fields: [employeeId], references: [id])
  type                 String
  issuedDate           DateTime
  expiryDate           DateTime
  status               String
  notes                String?
  documentUrl          String?
  archivedAt           DateTime?
  lastAlertFingerprint String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([employeeId])
  @@index([expiryDate])
}
